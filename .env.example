# ==========================================
# CẤU HÌNH SUPABASE (Database & Auth)
# Lấy từ: Project Settings -> API trên Supabase Dashboard
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ==========================================
# CẤU HÌNH CLOUDFLARE R2 (Lưu trữ ảnh S3)
# Lấy từ: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# ==========================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=my-todo-images
# URL public của Bucket R2 (hoặc custom domain, ví dụ: https://pub-xxx.r2.dev hoặc https://images.yourdomain.com)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
